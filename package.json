{
  "name": "seldon",
  "version": "0.0.0",
  "private": true,
  "description": "Seldon · Core, Editor, and Factory",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace @seldon/editor-react",
    "dev:vue": "npm run dev --workspace @seldon/editor-vue",
    "build": "npm run build --workspace @seldon/editor-react",
    "build:vue": "npm run build --workspace @seldon/editor-vue",
    "build:release": "npm run build:release --workspace @seldon/editor-react",
    "build:release:vue": "npm run build:release --workspace @seldon/editor-vue",
    "start": "npm run start --workspace @seldon/editor-react",
    "start:vue": "npm run start --workspace @seldon/editor-vue",
    "check": "node scripts/check.mjs",
    "format": "node scripts/format.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,json,css,js,mjs}\"",
    "lint": "npm run lint --workspace @seldon/editor-react",
    "lint:vue": "npm run lint --workspace @seldon/editor-vue",
    "lint:shared": "npm run lint --workspace @seldon/editor",
    "lint:all": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspace @seldon/editor-react",
    "lint:fix:vue": "npm run lint:fix --workspace @seldon/editor-vue",
    "lint:fix:shared": "npm run lint:fix --workspace @seldon/editor",
    "lint:fix:all": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace @seldon/editor-react",
    "typecheck:vue": "npm run typecheck --workspace @seldon/editor-vue",
    "typecheck:all": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "export:seldon": "npm run export:seldon --workspace @seldon/editor-react",
    "export:seldon:vue": "npm run export:seldon --workspace @seldon/editor-vue",
    "bindings": "npm run bindings --workspace @seldon/editor-react --workspace @seldon/editor-vue",
    "bindings:check": "npm run bindings:check --workspace @seldon/editor-react --workspace @seldon/editor-vue",
    "notices:thirdparty": "node packages/editor/shared/scripts/generate-third-party-notices.mjs",
    "ollama:ensure": "npm run ollama:ensure --workspace @seldon/ai",
    "ollama:kill": "npm run ollama:kill --workspace @seldon/ai",
    "build:packages": "npm run build --workspace @seldon/core --workspace @seldon/factory --workspace @seldon/ai --workspace @seldon/terminus --workspace @seldon/hari",
    "changeset": "changeset",
    "version": "changeset version",
    "verify:packages": "node scripts/verify-packages.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeldonDigital/seldon.git"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN ./license/noncommercial/LICENSE.md",
  "bugs": {
    "url": "https://github.com/SeldonDigital/seldon/issues"
  },
  "homepage": "https://github.com/SeldonDigital/seldon#readme",
  "workspaces": [
    "packages/editor/shared",
    "packages/editor/apps/react",
    "packages/editor/apps/vue",
    "packages/core",
    "packages/factory",
    "packages/ai",
    "packages/bundles/terminus",
    "packages/bundles/hari",
    "packages/bundles/foundation",
    "apps/desktop"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "@changesets/cli": "^2.27.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@iconify-json/carbon": "^1.2.25",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/material-symbols": "^1.2.88",
    "@iconify/utils": "^3.1.4",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.10.6",
    "prettier": "^3.3.3",
    "publint": "^0.3.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "volta": {
    "node": "22.18.0"
  }
}
