{
  "name": "@seldon/foundation",
  "version": "0.0.0",
  "type": "module",
  "description": "The full Seldon platform: the workspace engine (@seldon/core), export factory (@seldon/factory), local AI orchestration (@seldon/ai), and the embeddable editor library (@seldon/editor), plus the AI editor-server plugins (agent chat and MCP bridge). Ships as source for a consumer bundler.",
  "license": "SEE LICENSE IN ../../../license/noncommercial/LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeldonDigital/seldon.git",
    "directory": "packages/bundles/foundation"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./vite/*": "./vite/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "vite",
    "README.md",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@seldon/ai": "0.0.0",
    "@seldon/core": "0.0.0",
    "@seldon/editor": "0.0.0",
    "@seldon/factory": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3",
    "vite": "^8.0.0"
  }
}
