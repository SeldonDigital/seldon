{
  "extends": "../../../scripts/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "moduleResolution": "bundler",
    "customConditions": null,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@seldon/core": ["../../core/dist/index.d.ts"],
      "@seldon/core/*": ["../../core/dist/*"],
      "@seldon/factory": ["../../factory/dist/index.d.ts"],
      "@seldon/factory/*": ["../../factory/dist/*"],
      "@seldon/ai": ["../../ai/dist/index.d.ts"],
      "@seldon/ai/*": ["../../ai/dist/*"],
      "@seldon/terminus": ["../terminus/dist/index.d.ts"],
      "@seldon/hari": ["../hari/dist/index.d.ts"],
      "@seldon/editor": ["../../editor/shared/index.ts"],
      "@seldon/editor/*": ["../../editor/shared/*"]
    }
  },
  "include": ["index.ts"]
}
