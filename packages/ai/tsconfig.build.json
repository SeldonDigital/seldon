{
  "extends": "../../scripts/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": false,
    "declarationMap": false,
    "incremental": false,
    "rootDir": ".",
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "customConditions": null,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@seldon/core": ["../core/dist/index.d.ts"],
      "@seldon/core/*": ["../core/dist/*"],
      "@seldon/factory": ["../factory/dist/index.d.ts"],
      "@seldon/factory/*": ["../factory/dist/*"]
    }
  },
  "include": [
    "index.ts",
    "orchestrate.ts",
    "types.ts",
    "mcp/**/*.ts",
    "pi/**/*.ts",
    "prompt/**/*.ts",
    "repair/**/*.ts",
    "schema/**/*.ts",
    "server/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
