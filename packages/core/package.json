{
  "name": "@seldon/core",
  "version": "0.0.0",
  "type": "module",
  "description": "Seldon core: components, properties, themes, and the workspace engine that editors and agents drive through actions.",
  "license": "SEE LICENSE IN ../../license/noncommercial/LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeldonDigital/seldon.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node ../../scripts/bundle-package-entry.mjs index.ts dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "node ../../scripts/format.mjs",
    "icons": "node ../../scripts/generate-icons.mjs",
    "generate:action-schema": "typescript-json-schema ./tsconfig.schema.json WorkspaceAction --out ./workspace/reducers/workspace-action-schema.json --noExtraProps --required"  },
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.d.ts",
        "development": "./index.ts",
        "default": "./dist/index.js"
      },
      "default": "./index.ts"
    },
    "./icon-sets": {
      "node": {
        "types": "./dist/icon-sets/index.d.ts",
        "development": "./icon-sets/index.ts",
        "default": "./dist/icon-sets/index.js"
      },
      "default": "./icon-sets/index.ts"
    },
    "./icon-sets/data": {
      "node": {
        "types": "./dist/icon-sets/data/index.d.ts",
        "development": "./icon-sets/data/index.ts",
        "default": "./dist/icon-sets/data/index.js"
      },
      "default": "./icon-sets/data/index.ts"
    },
    "./helpers/validation": {
      "node": {
        "types": "./dist/helpers/validation/index.d.ts",
        "development": "./helpers/validation/index.ts",
        "default": "./dist/helpers/validation/index.js"
      },
      "default": "./helpers/validation/index.ts"
    },
    "./properties": {
      "node": {
        "types": "./dist/properties/index.d.ts",
        "development": "./properties/index.ts",
        "default": "./dist/properties/index.js"
      },
      "default": "./properties/index.ts"
    },
    "./properties/constants": {
      "node": {
        "types": "./dist/properties/constants/index.d.ts",
        "bun": "./properties/constants/index.ts",
        "development": "./properties/constants/index.ts",
        "default": "./dist/properties/constants/index.js"
      },
      "default": "./properties/constants/index.ts"
    },
    "./properties/types": {
      "node": {
        "types": "./dist/properties/types/index.d.ts",
        "development": "./properties/types/index.ts",
        "default": "./dist/properties/types/index.js"
      },
      "default": "./properties/types/index.ts"
    },
    "./properties/types/schema": {
      "node": {
        "types": "./dist/properties/types/schema.d.ts",
        "development": "./properties/types/schema.ts",
        "default": "./dist/properties/types/schema.js"
      },
      "default": "./properties/types/schema.ts"
    },
    "./properties/types/properties": {
      "node": {
        "types": "./dist/properties/types/properties.d.ts",
        "development": "./properties/types/properties.ts",
        "default": "./dist/properties/types/properties.js"
      },
      "default": "./properties/types/properties.ts"
    },
    "./properties/schemas": {
      "node": {
        "types": "./dist/properties/schemas/index.d.ts",
        "development": "./properties/schemas/index.ts",
        "default": "./dist/properties/schemas/index.js"
      },
      "default": "./properties/schemas/index.ts"
    },
    "./properties/schemas/helpers": {
      "node": {
        "types": "./dist/properties/schemas/helpers/index.d.ts",
        "development": "./properties/schemas/helpers/index.ts",
        "default": "./dist/properties/schemas/helpers/index.js"
      },
      "default": "./properties/schemas/helpers/index.ts"
    },
    "./properties/values": {
      "node": {
        "types": "./dist/properties/values/index.d.ts",
        "development": "./properties/values/index.ts",
        "default": "./dist/properties/values/index.js"
      },
      "default": "./properties/values/index.ts"
    },
    "./properties/helpers": {
      "node": {
        "types": "./dist/properties/helpers/index.d.ts",
        "development": "./properties/helpers/index.ts",
        "default": "./dist/properties/helpers/index.js"
      },
      "default": "./properties/helpers/index.ts"
    },
    "./properties/compute": {
      "node": {
        "types": "./dist/properties/compute/index.d.ts",
        "development": "./properties/compute/index.ts",
        "default": "./dist/properties/compute/index.js"
      },
      "default": "./properties/compute/index.ts"
    },
    "./workspace/compute": {
      "node": {
        "types": "./dist/workspace/compute/index.d.ts",
        "development": "./workspace/compute/index.ts",
        "default": "./dist/workspace/compute/index.js"
      },
      "default": "./workspace/compute/index.ts"
    },
    "./themes/compute": {
      "node": {
        "types": "./dist/themes/compute/index.d.ts",
        "development": "./themes/compute/index.ts",
        "default": "./dist/themes/compute/index.js"
      },
      "default": "./themes/compute/index.ts"
    },
    "./themes/types": {
      "node": {
        "types": "./dist/themes/types/index.d.ts",
        "development": "./themes/types/index.ts",
        "default": "./dist/themes/types/index.js"
      },
      "default": "./themes/types/index.ts"
    },
    "./themes/values": {
      "node": {
        "types": "./dist/themes/values/index.d.ts",
        "development": "./themes/values/index.ts",
        "default": "./dist/themes/values/index.js"
      },
      "default": "./themes/values/index.ts"
    },
    "./helpers/math": {
      "node": {
        "types": "./dist/helpers/math/index.d.ts",
        "development": "./helpers/math/index.ts",
        "default": "./dist/helpers/math/index.js"
      },
      "default": "./helpers/math/index.ts"
    },
    "./package.json": "./package.json",
    "./*": {
      "node": {
        "types": "./dist/*.d.ts",
        "development": "./*.ts",
        "default": "./dist/*.js"
      },
      "default": "./*.ts"
    }
  },
  "files": [
    "dist",
    "components",
    "font-collections",
    "helpers",
    "icon-lookup.ts",
    "icon-sets",
    "properties",
    "rules",
    "themes",
    "utils",
    "workspace",
    "index.ts",
    "constants.ts",
    "README.md",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/react": "^16.3.0",
    "eslint": "^9.39.4",
    "typescript-eslint": "^8.61.0",
    "typescript-json-schema": "^0.68.0"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@types/chroma-js": "^2.4.5",
    "@types/lodash": "^4.17.20",
    "@types/pluralize": "^0.0.33",
    "chroma-js": "^3.1.2",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "nanoid": "^5.1.4",
    "pluralize": "^8.0.0"
  }
}
